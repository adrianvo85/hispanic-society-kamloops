---
interface Props { light?: boolean; }
const { light = false } = Astro.props;
const colors = ["#E5097F", "#F5C518", "#2E9A5C", "#17A8B4", "#283E7D"];
---
<div class:list={["papel-picado", { "is-light": light }]} aria-hidden="true">
  <svg viewBox="0 0 1200 36" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    {Array.from({ length: 20 }, (_, i) => {
      const x = i * 60;
      const fill = colors[i % colors.length];
      return (
        <g fill={fill}>
          <path d={`M${x} 0 h60 l-6 30 c-8 10-16 10-24 0 l-6-30`} />
          <circle cx={x + 30} cy="12" r="3.2" fill={light ? "#eef1f2" : "#07090d"} />
          <path d={`M${x + 22} 20 l8 7 8-7`} fill={light ? "#eef1f2" : "#07090d"} />
        </g>
      );
    })}
  </svg>
</div>
