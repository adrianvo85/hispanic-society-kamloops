---
import { t } from "../lib/i18n";
import { pagePath, withBase, type Lang } from "../lib/paths";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = t(lang);
---
<section class="hero">
  <div class="hero-media">
    <video
      data-hero-video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={withBase("/videos/hero-poster.jpg")}
      aria-hidden="true"
    >
      <source src={withBase("/videos/hero.webm")} type="video/webm" />
      <source src={withBase("/videos/hero.mp4")} type="video/mp4" />
    </video>
    <img class="poster" src={withBase("/videos/hero-poster.jpg")} alt="" data-hero-poster hidden />
  </div>
  <div class="hero-shade"></div>
  <div class="hero-copy">
    <p class="hero-kicker">
      {copy.hero.kicker}
    </p>
    <hr class="hero-rule" />
    <p class="hero-welcome">{copy.hero.welcome}</p>
    <h1>{copy.hero.headline}</h1>
    <p class="hero-lede">{copy.hero.lede}</p>
    <div class="hero-actions">
      <a class="btn btn-solid" href={pagePath(lang, "volunteer")}>{copy.hero.joinFamily}</a>
      <a class="btn btn-jade" href={pagePath(lang, "dance")}>{copy.hero.comeDance}</a>
      <a class="btn btn-events" href={pagePath(lang, "events")}>{copy.hero.watchEvents}</a>
      <a class="btn btn-donate" href={pagePath(lang, "donate")}>
        <svg class="btn-heart" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12.1 21.35 10.6 20C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.6 11.5l-1.3 1.35Z"/></svg>
        {copy.hero.donate}
      </a>
    </div>
  </div>
  <button class="hero-toggle" type="button" data-hero-toggle>{copy.hero.pause}</button>
</section>
