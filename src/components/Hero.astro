---
import { t } from "../lib/i18n";
import { pagePath, withBase, type Lang } from "../lib/paths";
import settings from "../content/site/settings.json";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = t(lang);
---
<section class="hero">
  <div class="hero-media">
    <video
      data-hero-video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={withBase("/videos/hero-poster.jpg")}
      aria-hidden="true"
    >
      <source src={withBase("/videos/hero.webm")} type="video/webm" />
      <source src={withBase("/videos/hero.mp4")} type="video/mp4" />
    </video>
    <img class="poster" src={withBase("/videos/hero-poster.jpg")} alt="" data-hero-poster hidden />
  </div>
  <div class="hero-shade"></div>
  <div class="hero-copy">
    <p class="hero-kicker">
      {copy.hero.kicker}
      <span aria-hidden="true">·</span>
      <a href={settings.orgbookUrl} rel="noopener">{copy.hero.society}</a>
    </p>
    <hr class="hero-rule" />
    <h1>{copy.hero.headline}</h1>
    <p class="hero-lede">{copy.hero.lede}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={pagePath(lang, "donate")}>
        <span class="dot" aria-hidden="true"></span>
        {copy.hero.donate}
      </a>
      <a class="btn btn-solid" href={pagePath(lang, "events")}>{copy.hero.watchEvents}</a>
    </div>
  </div>
  <p class="hero-credit">{copy.hero.videoCredit}</p>
  <button class="hero-toggle" type="button" data-hero-toggle>{copy.hero.pause}</button>
</section>
