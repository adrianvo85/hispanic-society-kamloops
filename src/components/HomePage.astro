---
import EventCard from "./EventCard.astro";
import Hero from "./Hero.astro";
import PapelPicado from "./PapelPicado.astro";
import letter from "../content/site/letter.json";
import { t, pick } from "../lib/i18n";
import { pagePath, withBase, type Lang } from "../lib/paths";
import { allEvents, splitEvents } from "../lib/events";
import { getCollection } from "astro:content";
import settings from "../content/site/settings.json";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = t(lang);
const events = await allEvents();
const { upcoming, past } = splitEvents(events);
const featuredPast = past.filter((e) => e.data.featured).slice(0, 3);
const pastPreview = featuredPast.length ? featuredPast : past.slice(0, 3);
const sponsors = await getCollection("sponsors");
const partners = (await getCollection("partners")).sort((a, b) => a.data.order - b.data.order);
const documented = events.length;
const cultureCards = [
  { title: copy.culture.card1Title, body: copy.culture.card1Body },
  { title: copy.culture.card2Title, body: copy.culture.card2Body },
  { title: copy.culture.card3Title, body: copy.culture.card3Body },
  { title: copy.culture.card4Title, body: copy.culture.card4Body },
];
---
<Hero lang={lang} />

<section class="manifesto skin-navy" id="vision">
  <div class="wrap">
    <p class="eyebrow reveal">{copy.manifesto.eyebrow}</p>
    <h2 class="reveal">{copy.manifesto.line1}<br />{copy.manifesto.line2}<br />{copy.manifesto.line3}</h2>
    <p class="lede reveal">{copy.manifesto.body}</p>
    <ul class="motto reveal">
      {copy.mottoWords.map((w) => <li><i></i>{w}</li>)}
    </ul>
  </div>
</section>

<PapelPicado />

<section class="section skin-cream" id="letter" style="padding-top:6rem;padding-bottom:6rem">
  <div class="wrap letter-teaser">
    <div class="reveal">
      <p class="eyebrow">{copy.letter.eyebrow}</p>
      <h2>{copy.letter.title}</h2>
      <p class="lede">{copy.letter.teaser}</p>
      {letter.draft && <p><span class="badge-example">{copy.letter.draftBadge}</span></p>}
      <p style="margin-top:2rem">
        <a class="btn btn-dark" href={pagePath(lang, "letter")}>{copy.letter.read}</a>
      </p>
    </div>
    <div class="reveal">
      <p class="letter-name" style="margin:0;font-size:1.8rem;font-weight:600">{pick(lang, letter.presidentName_en, letter.presidentName_es)}</p>
      <p class="muted-sm">{pick(lang, letter.role_en, letter.role_es)}</p>
    </div>
  </div>
</section>

<section class="impact skin-navy" id="impact">
  <div class="wrap-wide">
    <div class="section-head reveal">
      <p class="eyebrow">{copy.impact.eyebrow}</p>
      <h2>{copy.impact.title}</h2>
      <p class="lede">{copy.impact.body}</p>
    </div>
    <div class="impact-grid">
      <div class="stat reveal">
        <strong>2019</strong>
        <span>{copy.impact.sinceLabel}</span>
      </div>
      <div class="stat reveal">
        <strong>S0071166</strong>
        <span>{copy.impact.societyLabel}</span>
      </div>
      <div class="stat reveal">
        <strong>{documented}</strong>
        <span>{copy.impact.eventsLabel}</span>
      </div>
      <div class="stat reveal">
        <strong>{partners.length}</strong>
        <span>{copy.impact.partnersLabel}</span>
      </div>
      <div class="stat reveal">
        <strong>{copy.impact.languagesValue}</strong>
        <span>{copy.impact.languagesLabel}</span>
      </div>
    </div>
  </div>
</section>

<section class="section skin-aztec" id="events">
  <div class="wrap-wide">
    <div class="section-head reveal">
      <p class="eyebrow">{copy.upcoming.eyebrow}</p>
      <h2>{copy.upcoming.title}</h2>
    </div>
    {upcoming.length === 0 ? (
      <p class="empty-state reveal">{copy.upcoming.empty}</p>
    ) : (
      <div class="grid-cards">
        {upcoming.map((event) => <EventCard lang={lang} event={event} />)}
      </div>
    )}

    {pastPreview.length > 0 && (
      <div style="margin-top:6rem">
        <div class="section-head reveal">
          <p class="eyebrow">{copy.galleryCta.eyebrow}</p>
          <h2>{copy.upcoming.pastTitle}</h2>
          <p class="lede">{copy.galleryCta.body}</p>
          <p class="stock-caption">{copy.media.realGallery}</p>
        </div>
        <div class="grid-cards">
          {pastPreview.map((event) => <EventCard lang={lang} event={event} />)}
        </div>
        <p style="margin-top:2rem">
          <a class="btn btn-dark" href={pagePath(lang, "events")}>{copy.upcoming.allEvents}</a>
        </p>
      </div>
    )}
  </div>
</section>

<section class="section skin-teal" id="culture">
  <div class="wrap">
    <p class="eyebrow reveal">{copy.culture.eyebrow}</p>
    <h2 class="reveal">{copy.culture.title}</h2>
    <p class="lede reveal">{copy.culture.lede}</p>
    <div class="culture-grid">
      {cultureCards.map((c) => (
        <article class="culture-card reveal">
          <span class="coming-soon">{copy.culture.comingSoon}</span>
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </article>
      ))}
    </div>
    <p class="note reveal" style="margin-top:1.6rem;color:rgba(255,248,239,0.92)">{copy.culture.note}</p>
    <p style="margin-top:2rem">
      <a class="btn btn-solid" href={pagePath(lang, "learn")}>{copy.culture.cta}</a>
    </p>
  </div>
</section>

<section class="section skin-cream" id="dance">
  <div class="wrap">
    <p class="eyebrow reveal">{copy.dance.eyebrow}</p>
    <h2 class="reveal">{copy.dance.title}</h2>
    <p class="lede reveal">{copy.dance.intro}</p>
    <p class="note">{copy.dance.formerly}</p>
    <p style="margin-top:2rem;display:flex;flex-wrap:wrap;gap:0.8rem">
      <a class="btn btn-dark" href={pagePath(lang, "dance")}>{copy.dance.joinCta}</a>
      <a class="btn btn-jade" href={pagePath(lang, "dance") + "#hire"}>{copy.dance.hireCta}</a>
    </p>
  </div>
</section>

<section class="section skin-talavera" id="donate">
  <div class="wrap">
    <p class="eyebrow reveal">{copy.donate.eyebrow}</p>
    <h2 class="reveal">{copy.donate.title}</h2>
    <p class="lede reveal">{copy.donate.body}</p>
    <div class="amounts reveal">
      {copy.donate.amounts.map((n) => {
        const href = settings.zeffyDonateUrl || pagePath(lang, "donate");
        return (
          <a class="amount" href={href}>
            <strong>${n}</strong>
            <span>CAD</span>
          </a>
        );
      })}
    </div>
    {settings.zeffyDonateUrl ? (
      <a class="btn btn-dark" href={settings.zeffyDonateUrl} rel="noopener">{copy.donate.cta}</a>
    ) : (
      <p class="note reveal">{copy.donate.pending}</p>
    )}
    <p class="note" style="margin-top:1.6rem">{copy.donate.invoiceNote}</p>
    <div class="panel" style="margin-top:2.8rem">
      <p class="eyebrow">{copy.donate.almaEyebrow}</p>
      <h3 style="margin:0.4rem 0 0.8rem;font-size:2.2rem">{copy.donate.almaTitle}</h3>
      <p>{copy.donate.almaBody}</p>
      <p style="margin-top:1.4rem">
        <a class="btn btn-dark" href={pagePath(lang, "dance") + "#support"}>{copy.donate.almaCta}</a>
      </p>
    </div>
    <p style="margin-top:1.8rem">
      <a class="btn btn-solid" href={pagePath(lang, "donate")}>{copy.donate.cta}</a>
    </p>
  </div>
</section>

<section class="section skin-maya" id="volunteer">
  <div class="wrap reveal">
    <p class="eyebrow">{copy.volunteer.eyebrow}</p>
    <h2 style="font-size:clamp(3rem,5vw,5.4rem);font-weight:400;letter-spacing:-0.03em;max-width:16ch;margin:0.6rem 0 1.2rem">{copy.volunteer.title}</h2>
    <p class="lede">{copy.volunteer.body}</p>
    <p style="margin-top:2rem">
      <a class="btn btn-solid" href={pagePath(lang, "volunteer")}>{copy.volunteer.sticky}</a>
    </p>
  </div>
</section>

<section class="section skin-cream" id="sponsors">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{copy.sponsors.eyebrow}</p>
      <h2>{copy.sponsors.wallTitle}</h2>
    </div>
    <div class="wall">
      {sponsors.map((s) => (
        <a class="wall-item" href={s.data.url || pagePath(lang, "sponsors")} rel={s.data.url ? "noopener" : undefined}>
          {s.data.logo ? <img class="sponsor-logo" src={withBase(s.data.logo)} alt={s.data.name} /> : <strong>{s.data.name}</strong>}
          <strong>{s.data.name}</strong>
          <p class="muted-sm">{pick(lang, s.data.tierLabel_en, s.data.tierLabel_es)}</p>
        </a>
      ))}
    </div>
    <p style="margin-top:2rem">
      <a class="btn btn-dark" href={pagePath(lang, "sponsors")}>{copy.sponsors.programCta}</a>
    </p>
  </div>
</section>

<section class="section skin-cream" id="about" style="background:var(--paper-2)">
  <div class="wrap">
    <p class="eyebrow reveal">{copy.about.eyebrow}</p>
    <h2 class="reveal">{copy.about.missionTitle}</h2>
    <p class="lede reveal">{copy.about.missionBody}</p>
    <p class="pending-note">{copy.about.proposedNote}</p>
    <p style="margin-top:2.4rem;display:flex;flex-wrap:wrap;gap:0.8rem">
      <a class="btn btn-dark" href={pagePath(lang, "about")}>{copy.nav.about}</a>
      <a class="btn btn-ghost" href={pagePath(lang, "board")}>{copy.trust.boardCta}</a>
      <a class="btn btn-ghost" href={pagePath(lang, "contact")}>{copy.nav.contact}</a>
    </p>
  </div>
</section>
