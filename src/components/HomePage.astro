---
import EventCard from "./EventCard.astro";
import Hero from "./Hero.astro";
import { t, pick } from "../lib/i18n";
import { pagePath, withBase, type Lang } from "../lib/paths";
import { allEvents, splitEvents } from "../lib/events";
import { getCollection } from "astro:content";
import settings from "../content/site/settings.json";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = t(lang);
const events = await allEvents();
const { upcoming, past } = splitEvents(events);
const featuredPast = past.filter((e) => e.data.featured).slice(0, 3);
const pastPreview = featuredPast.length ? featuredPast : past.slice(0, 3);
const sponsors = await getCollection("sponsors");
const partners = (await getCollection("partners")).sort((a, b) => a.data.order - b.data.order);
const documented = events.length;
---
<Hero lang={lang} />

<section class="manifesto" id="vision">
  <div class="wrap">
    <p class="eyebrow reveal">{copy.manifesto.eyebrow}</p>
    <h2 class="reveal">{copy.manifesto.line1}<br />{copy.manifesto.line2}<br />{copy.manifesto.line3}</h2>
    <p class="lede reveal">{copy.manifesto.body}</p>
    <ul class="motto reveal">
      {copy.mottoWords.map((w) => <li><i></i>{w}</li>)}
    </ul>
  </div>
</section>

<section class="impact" id="impact">
  <div class="wrap-wide">
    <div class="section-head reveal">
      <p class="eyebrow">{copy.impact.eyebrow}</p>
      <h2>{copy.impact.title}</h2>
      <p class="lede">{copy.impact.body}</p>
    </div>
    <div class="impact-grid">
      <div class="stat reveal">
        <strong>2019</strong>
        <span>{copy.impact.sinceLabel}</span>
      </div>
      <div class="stat reveal">
        <strong>S0071166</strong>
        <span>{copy.impact.societyLabel}</span>
      </div>
      <div class="stat reveal">
        <strong>{documented}</strong>
        <span>{copy.impact.eventsLabel}</span>
      </div>
      <div class="stat reveal">
        <strong>{partners.length}</strong>
        <span>{copy.impact.partnersLabel}</span>
      </div>
      <div class="stat reveal">
        <strong>{copy.impact.languagesValue}</strong>
        <span>{copy.impact.languagesLabel}</span>
      </div>
    </div>
  </div>
</section>

<section class="section" id="events">
  <div class="wrap-wide">
    <div class="section-head reveal">
      <p class="eyebrow">{copy.upcoming.eyebrow}</p>
      <h2>{copy.upcoming.title}</h2>
    </div>
    {upcoming.length === 0 ? (
      <p class="empty-state reveal">{copy.upcoming.empty}</p>
    ) : (
      <div class="grid-cards">
        {upcoming.map((event) => <EventCard lang={lang} event={event} />)}
      </div>
    )}

    {pastPreview.length > 0 && (
      <div style="margin-top:6rem">
        <div class="section-head reveal">
          <p class="eyebrow">{copy.galleryCta.eyebrow}</p>
          <h2>{copy.upcoming.pastTitle}</h2>
          <p class="lede">{copy.galleryCta.body}</p>
          <p class="stock-caption">{copy.media.realGallery}</p>
        </div>
        <div class="grid-cards">
          {pastPreview.map((event) => <EventCard lang={lang} event={event} />)}
        </div>
        <p style="margin-top:2rem">
          <a class="btn btn-ghost" href={pagePath(lang, "events")}>{copy.upcoming.allEvents}</a>
        </p>
      </div>
    )}
  </div>
</section>

<section class="section-dark section" id="donate">
  <div class="wrap">
    <p class="eyebrow reveal">{copy.donate.eyebrow}</p>
    <h2 class="reveal">{copy.donate.title}</h2>
    <p class="lede reveal">{copy.donate.body}</p>
    <div class="amounts reveal">
      {copy.donate.amounts.map((n) => {
        const href = settings.zeffyDonateUrl || pagePath(lang, "donate");
        return (
          <a class="amount" href={href}>
            <strong>${n}</strong>
            <span>CAD</span>
          </a>
        );
      })}
    </div>
    {settings.zeffyDonateUrl ? (
      <a class="btn btn-primary" href={settings.zeffyDonateUrl} rel="noopener">
        <span class="dot" aria-hidden="true"></span>
        {copy.donate.cta}
      </a>
    ) : (
      <p class="note reveal">{copy.donate.pending}</p>
    )}
    <p class="lede" style="margin-top:1.6rem">{copy.donate.invoiceNote}</p>
    <p style="margin-top:1.8rem">
      <a class="btn btn-solid" href={pagePath(lang, "donate")}>{copy.donate.cta}</a>
    </p>
  </div>
</section>

<section class="band-photo" style={`background-image:url('${withBase("/images/stock/festival-night.jpg")}')`}>
  <div class="shade"></div>
  <div class="copy wrap reveal">
    <p class="eyebrow" style="color:#fff">{copy.volunteer.eyebrow}</p>
    <h2 style="font-size:clamp(3rem,5vw,5.4rem);font-weight:400;letter-spacing:-0.03em;max-width:16ch;margin:0.6rem 0 1.2rem">{copy.volunteer.title}</h2>
    <p class="lede" style="color:rgba(255,255,255,0.8)">{copy.volunteer.body}</p>
    <p style="margin-top:2rem">
      <a class="btn btn-solid" href={pagePath(lang, "volunteer")}>{copy.volunteer.sticky}</a>
    </p>
    <p class="stock-caption">{copy.media.stock}</p>
  </div>
</section>

<section class="section" id="sponsors">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{copy.sponsors.eyebrow}</p>
      <h2>{copy.sponsors.wallTitle}</h2>
    </div>
    <div class="wall">
      {sponsors.map((s) => (
        <a class="wall-item" href={s.data.url || pagePath(lang, "sponsors")}>
          {s.data.logo ? <img src={s.data.logo} alt={s.data.name} /> : <strong>{s.data.name}</strong>}
          <p class="muted-sm">{pick(lang, s.data.tierLabel_en, s.data.tierLabel_es)}</p>
        </a>
      ))}
    </div>
    <p style="margin-top:2rem">
      <a class="btn btn-dark" href={pagePath(lang, "sponsors")}>{copy.sponsors.programCta}</a>
    </p>
  </div>
</section>

<section class="section section-alt" id="about">
  <div class="wrap">
    <p class="eyebrow reveal">{copy.about.eyebrow}</p>
    <h2 class="reveal">{copy.about.title}</h2>
    <p class="lede reveal">{lang === "es" ? settings.chlavmDescriptionEs : settings.chlavmDescriptionEn}</p>
    <p class="note">{copy.about.directoryNote}</p>
    <p class="lede" style="margin-top:1.4rem">{copy.about.history}</p>
    <h3 style="font-size:2.2rem;font-weight:500;margin:3.2rem 0 1.2rem">{copy.about.partners}</h3>
    <div class="partners">
      {partners.map((p) => (
        <a class="partner" href={p.data.url} rel="noopener">
          <h3>{pick(lang, p.data.name_en, p.data.name_es)}</h3>
        </a>
      ))}
    </div>
    <p style="margin-top:2.4rem;display:flex;flex-wrap:wrap;gap:0.8rem">
      <a class="btn btn-ghost" href={pagePath(lang, "about")}>{copy.nav.about}</a>
      <a class="btn btn-dark" href={pagePath(lang, "board")}>{copy.trust.boardCta}</a>
      <a class="btn btn-ghost" href={pagePath(lang, "contact")}>{copy.nav.contact}</a>
    </p>
  </div>
</section>
