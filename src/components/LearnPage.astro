---
import { t } from "../lib/i18n";
import { pagePath, type Lang } from "../lib/paths";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = t(lang);
const cards = [
  { title: copy.culture.card1Title, body: copy.culture.card1Body },
  { title: copy.culture.card2Title, body: copy.culture.card2Body },
  { title: copy.culture.card3Title, body: copy.culture.card3Body },
  { title: copy.culture.card4Title, body: copy.culture.card4Body },
];
---
<section class="page-hero skin-navy">
  <div class="wrap">
    <p class="eyebrow">{copy.culture.eyebrow}</p>
    <h1>{copy.culture.title}</h1>
    <p class="lede">{copy.culture.lede}</p>
  </div>
</section>
<section class="section skin-teal">
  <div class="wrap">
    <div class="culture-grid">
      {cards.map((c) => (
        <article class="culture-card">
          <span class="coming-soon">{copy.culture.comingSoon}</span>
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </article>
      ))}
    </div>
    <p class="note" style="margin-top:1.8rem;color:rgba(255,248,239,0.92)">{copy.culture.note}</p>
    <p style="margin-top:2rem;display:flex;flex-wrap:wrap;gap:0.8rem">
      <a class="btn btn-solid" href={pagePath(lang, "events")}>{copy.hero.watchEvents}</a>
      <a class="btn btn-primary" href={pagePath(lang, "dance")}>{copy.hero.comeDance}</a>
    </p>
  </div>
</section>
