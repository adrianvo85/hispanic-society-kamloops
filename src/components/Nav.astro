---
import { t } from "../lib/i18n";
import { pagePath, withLang, type Lang } from "../lib/paths";
import OfficialLogo from "./OfficialLogo.astro";
interface Props { lang: Lang; currentPath: string; }
const { lang, currentPath } = Astro.props;
const copy = t(lang);
const links = [
  { href: pagePath(lang, "events"), label: copy.nav.events },
  { href: pagePath(lang, "dance"), label: copy.nav.dance },
  { href: pagePath(lang, "volunteer"), label: copy.nav.volunteer },
  { href: pagePath(lang, "sponsors"), label: copy.nav.sponsors },
  { href: pagePath(lang, "board"), label: copy.nav.board },
  { href: pagePath(lang, "about"), label: copy.nav.about },
  { href: pagePath(lang, "contact"), label: copy.nav.contact },
];
const isActive = (href: string) => currentPath.replace(/\/$/, "") === href.replace(/\/$/, "");
---
<header class="nav" data-nav>
  <a class="nav-brand" href={pagePath(lang)}>
    <OfficialLogo alt={copy.logo.altWordmark} />
  </a>
  <nav aria-label="Primary">
    <ul class="nav-links" data-nav-links>
      {links.map((l) => (
        <li><a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
  <div class="nav-cta">
    <div class="lang-toggle" aria-label="Language">
      <a href={withLang("en", currentPath)} aria-current={lang === "en" ? "true" : undefined} lang="en">EN</a>
      <a href={withLang("es", currentPath)} aria-current={lang === "es" ? "true" : undefined} lang="es">ES</a>
    </div>
    <a class="btn btn-donate" href={pagePath(lang, "donate")}>
      <svg class="btn-heart" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12.1 21.35 10.6 20C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.6 11.5l-1.3 1.35Z"/></svg>
      {copy.donate.sticky}
    </a>
    <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu">
      <span></span>
    </button>
  </div>
</header>
