---
import { t } from "../lib/i18n";
import type { Lang } from "../lib/paths";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = t(lang);
---
<footer class="site-footer">
  <div class="wrap footer-row">
    <div>
      <p>{copy.footer.legal}</p>
      <p style="margin-top:0.5rem;opacity:0.7">{copy.footer.privacy}</p>
    </div>
    <p>
      <a class="tresd" href="https://tresd.ca" rel="noopener">
        {copy.footer.credit}
      </a>
    </p>
  </div>
</footer>
