---
import { t } from "../lib/i18n";
import { pagePath, type Lang } from "../lib/paths";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = t(lang);
---
<div class="sticky-cta">
  <a class="btn btn-primary" href={pagePath(lang, "donate")}>
    <span class="dot" aria-hidden="true"></span>
    {copy.donate.sticky}
  </a>
</div>
