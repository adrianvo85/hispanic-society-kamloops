---
import { t, pick } from "../lib/i18n";
import type { Lang } from "../lib/paths";
import letter from "../content/site/letter.json";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = t(lang);
const name = pick(lang, letter.presidentName_en, letter.presidentName_es);
const role = pick(lang, letter.role_en, letter.role_es);
const date = pick(lang, letter.date_en, letter.date_es);
const greeting = pick(lang, letter.greeting_en, letter.greeting_es);
const body = pick(lang, letter.body_en, letter.body_es);
const closing = pick(lang, letter.closing_en, letter.closing_es);
---
<section class="page-hero skin-navy">
  <div class="wrap">
    <p class="eyebrow">{copy.letter.eyebrow}</p>
    <h1>{copy.letter.title}</h1>
    <p class="lede">{copy.letter.intro}</p>
  </div>
</section>
<section class="section skin-cream" style="padding-top:3rem">
  <div class="wrap">
    <article class="letter-sheet">
      {letter.draft && <span class="badge-example">{copy.letter.draftBadge}</span>}
      <p class="letter-meta">{date}</p>
      <p class="letter-name">{name}</p>
      <p class="muted-sm" style="margin:0.2rem 0 2rem">{role}</p>
      <div class="letter-body">
        <p>{greeting}</p>
        {body.split("\n\n").map((para) => <p>{para}</p>)}
      </div>
      <div class="letter-sign">
        <p>{closing}</p>
        <p class="letter-name">{name}</p>
        <p class="muted-sm">{role}</p>
      </div>
    </article>
  </div>
</section>
