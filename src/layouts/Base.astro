---
import "../styles/global.css";
import { t } from "../lib/i18n";
import { htmlLang, pagePath, switchLang, withBase, type Lang } from "../lib/paths";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import StickyCtas from "../components/StickyCtas.astro";
import settings from "../content/site/settings.json";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  currentPath?: string;
  image?: string;
}
const { lang, title, description, currentPath = Astro.url.pathname, image } = Astro.props;
const copy = t(lang);
const siteName = lang === "es" ? copy.siteTitleEs : copy.siteTitle;
const pageTitle = title ? `${title} — ${siteName}` : `${copy.siteTitleEs} · ${copy.siteTitle}`;
const desc = description || copy.seo.home;
const canonical = new URL(currentPath, Astro.site);
const ogImage = new URL(withBase(image || "/images/og-home.jpg"), Astro.site);
const other = switchLang(lang, currentPath);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: settings.legalName,
  alternateName: [settings.publicNameEs, settings.publicNameEn],
  foundingDate: settings.registered,
  identifier: settings.societyNumber,
  email: settings.email,
  url: String(Astro.site) + withBase("/").replace(/\/$/, "") + "/",
  areaServed: "Kamloops, British Columbia, Canada",
  sameAs: [settings.facebookUrl, settings.instagramUrl, settings.orgbookUrl],
};
---
<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#07090d" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-CA" href={new URL(lang === "en" ? currentPath : other, Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(lang === "es" ? currentPath : other, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(pagePath("en"), Astro.site)} />
    <link rel="icon" href={withBase("/favicon.png")} type="image/png" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === "es" ? "es" : "en_CA"} />
    <meta property="og:locale:alternate" content={lang === "es" ? "en_CA" : "es"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav lang={lang} currentPath={currentPath} />
    <main id="main">
      <slot />
    </main>
    <StickyCtas lang={lang} />
    <Footer lang={lang} />
    <script>
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
