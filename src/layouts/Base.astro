---
import "../styles/global.css";
import { t } from "../lib/i18n";
import { htmlLang, pagePath, switchLang, withBase, type Lang } from "../lib/paths";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import StickyCtas from "../components/StickyCtas.astro";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  currentPath?: string;
}

const { lang, title, description, currentPath = Astro.url.pathname } = Astro.props;
const copy = t(lang);
const pageTitle = title ? `${title} — ${copy.siteTitle}` : `${copy.siteTitleEs} · ${copy.siteTitle}`;
const desc = description || copy.seo.home;
const canonical = new URL(currentPath, Astro.site);
---
<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === "en" ? "es" : "en-CA"} href={new URL(switchLang(lang, currentPath), Astro.site)} />
    <link rel="icon" href={withBase("/favicon.png")} type="image/png" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(withBase("/images/logos/wordmark.png"), Astro.site)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav lang={lang} currentPath={currentPath} />
    <main id="main">
      <slot />
    </main>
    <StickyCtas lang={lang} />
    <Footer lang={lang} />
    <script>
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
